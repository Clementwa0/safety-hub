# Environment variables for Safety Hub
# Copy this file to .env.local or .env and fill in your values.

MONGODB_URI="your-mongodb-connection-string"
JWT_SECRET="your-staff-jwt-secret"
AUTH_SECRET="your-customer-auth-secret"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

CONTACT_EMAIL="your-business-email@gmail.com"
AUTH_EMAIL_SERVER_HOST="smtp.gmail.com"
AUTH_EMAIL_SERVER_PORT="587"
AUTH_EMAIL_SERVER_USER="your-gmail@gmail.com"
AUTH_EMAIL_SERVER_PASSWORD="your-google-app-password"
AUTH_EMAIL_FROM="your-gmail@gmail.com"

# If using Gmail SMTP, AUTH_EMAIL_SERVER_PASSWORD must be a Google App Password,
# not your regular Gmail password.
