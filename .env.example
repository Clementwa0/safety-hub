# Environment variables for Safety Hub
# Copy this file to .env (or .env.local) and fill in your own values.
# NEVER commit the real .env file — it is already listed in .gitignore.
# If a real .env with live secrets was ever committed or shared, treat every
# value in it as compromised and rotate it (see README/security notes).

MONGODB_URI="your-mongodb-connection-string"
AUTH_SECRET="generate-a-long-random-string"

# Auth.js (NextAuth) reads Google credentials from AUTH_GOOGLE_ID /
# AUTH_GOOGLE_SECRET by convention when no explicit clientId/clientSecret is
# passed to the Google() provider (see lib/auth/config.ts).
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Same convention for Facebook Login — from the app's Settings > Basic
# page at developers.facebook.com (see lib/auth/config.ts).
AUTH_FACEBOOK_ID="your-facebook-app-id"
AUTH_FACEBOOK_SECRET="your-facebook-app-secret"

CONTACT_EMAIL="your-business-email@gmail.com"
AUTH_EMAIL_SERVER_HOST="smtp.gmail.com"
AUTH_EMAIL_SERVER_PORT="587"
AUTH_EMAIL_SERVER_USER="your-gmail@gmail.com"
AUTH_EMAIL_SERVER_PASSWORD="your-google-app-password"
AUTH_EMAIL_FROM="your-gmail@gmail.com"

# If using Gmail SMTP, AUTH_EMAIL_SERVER_PASSWORD must be a Google App Password,
# not your regular Gmail password.

NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Secret the abandoned-cart cron endpoint (/api/cron/abandoned-carts) checks
# against, sent as an `Authorization: Bearer <secret>` header ONLY (no
# query-string fallback — query strings end up in logs, proxies, and
# browser history). Required — the route refuses to run without it. If
# deploying to Vercel with Vercel Cron, set this and Vercel will send it
# automatically as a header.
CRON_SECRET="generate-a-long-random-string"

# Hours a signed-in customer's cart must sit untouched before it's
# considered abandoned and a reminder email goes out. Optional, defaults to 2.
ABANDONED_CART_THRESHOLD_HOURS="1"

# Public-facing M-Pesa details shown on the checkout "Pay with M-Pesa" card.
# Customers pay manually to this Paybill/Till and staff confirm payment from
# the admin panel — there's no Daraja/STK push integration.
NEXT_PUBLIC_MPESA_PAYMENT_TYPE="paybill" # "paybill" or "till"
NEXT_PUBLIC_MPESA_BUSINESS_NUMBER="174379"
NEXT_PUBLIC_MPESA_BUSINESS_NAME="Safety Hub"

NEXT_PUBLIC_WHATSAPP_NUMBER="254700000000"
