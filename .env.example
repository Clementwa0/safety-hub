# --- Cloudinary (images) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Database ---
MONGODB_URI=

# --- Auth.js ---
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Document Share Links ---
# Signs standalone share tokens for quotation/order/invoice links (WhatsApp,
# copy link). Falls back to AUTH_SECRET if unset - see modules/sales-documents/share-token.ts.
JWT_SECRET=

# --- Email ---
AUTH_EMAIL_SERVER_HOST=
AUTH_EMAIL_SERVER_PORT=587
AUTH_EMAIL_SERVER_USER=
AUTH_EMAIL_SERVER_PASSWORD=
AUTH_EMAIL_FROM=
CONTACT_EMAIL=

# --- M-Pesa ---
NEXT_PUBLIC_MPESA_PAYMENT_TYPE=paybill
NEXT_PUBLIC_MPESA_BUSINESS_NUMBER=
NEXT_PUBLIC_MPESA_BUSINESS_NAME=Safety Hub

# --- WhatsApp ---
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000

# --- Cron ---
CRON_SECRET=
ABANDONED_CART_THRESHOLD_HOURS=24
